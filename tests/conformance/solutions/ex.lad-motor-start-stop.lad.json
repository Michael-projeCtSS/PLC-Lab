{
  "format": "plclab-lad",
  "version": 2,
  "name": "Main",
  "variables": [
    {
      "name": "StartPB",
      "type": "BOOL",
      "direction": "input",
      "comment": "Start button S1, normally open: TRUE while pressed."
    },
    {
      "name": "StopPB",
      "type": "BOOL",
      "direction": "input",
      "comment": "Stop button S2, normally closed: TRUE while NOT pressed (wire-break safe)."
    },
    {
      "name": "MotorFeedback",
      "type": "BOOL",
      "direction": "input",
      "comment": "Contactor auxiliary contact: TRUE when the contactor has pulled in."
    },
    {
      "name": "OverloadOK",
      "type": "BOOL",
      "direction": "input",
      "comment": "Overload relay contact, normally closed: TRUE while the motor is not overloaded."
    },
    {
      "name": "MotorContactor",
      "type": "BOOL",
      "direction": "output",
      "comment": "Contactor coil K1: TRUE energizes the motor."
    },
    {
      "name": "RunLamp",
      "type": "BOOL",
      "direction": "output",
      "comment": "Green run lamp H1."
    }
  ],
  "rungs": [
    {
      "id": 1,
      "comment": "Start or the contactor itself (self-holding); Stop and the overload relay break the circuit.",
      "network": {
        "type": "series",
        "id": 2,
        "items": [
          {
            "type": "parallel",
            "id": 5,
            "branches": [
              {
                "type": "contact",
                "id": 3,
                "contact": "normallyOpen",
                "variable": "StartPB"
              },
              {
                "type": "contact",
                "id": 4,
                "contact": "normallyOpen",
                "variable": "MotorContactor"
              }
            ]
          },
          {
            "type": "contact",
            "id": 6,
            "contact": "normallyOpen",
            "variable": "StopPB"
          },
          {
            "type": "contact",
            "id": 7,
            "contact": "normallyOpen",
            "variable": "OverloadOK"
          }
        ]
      },
      "coils": [
        {
          "id": 8,
          "variable": "MotorContactor"
        }
      ]
    },
    {
      "id": 9,
      "comment": "The auxiliary contact confirms the running motor.",
      "network": {
        "type": "series",
        "id": 10,
        "items": [
          {
            "type": "contact",
            "id": 11,
            "contact": "normallyOpen",
            "variable": "MotorFeedback"
          }
        ]
      },
      "coils": [
        {
          "id": 12,
          "variable": "RunLamp"
        }
      ]
    }
  ]
}
