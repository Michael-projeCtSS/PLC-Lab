{
  "format": "plclab-lad",
  "version": 2,
  "name": "Main",
  "variables": [
    {
      "name": "StartPB",
      "type": "BOOL",
      "direction": "input",
      "comment": "Start button S1, normally open: TRUE while pressed."
    },
    {
      "name": "StopPB",
      "type": "BOOL",
      "direction": "input",
      "comment": "Stop button S2, normally closed: TRUE while NOT pressed (wire-break safe)."
    },
    {
      "name": "MotorFeedback",
      "type": "BOOL",
      "direction": "input",
      "comment": "Contactor auxiliary contact: TRUE when the contactor has pulled in."
    },
    {
      "name": "OverloadOK",
      "type": "BOOL",
      "direction": "input",
      "comment": "Overload relay contact, normally closed: TRUE while the motor is not overloaded."
    },
    {
      "name": "MotorContactor",
      "type": "BOOL",
      "direction": "output",
      "comment": "Contactor coil K1: TRUE energizes the motor."
    },
    {
      "name": "RunLamp",
      "type": "BOOL",
      "direction": "output",
      "comment": "Green run lamp H1."
    },
    {
      "name": "Request",
      "type": "BOOL",
      "direction": "local",
      "comment": "Start request: latched by Start, cleared by Stop or an overload."
    }
  ],
  "rungs": [
    {
      "id": 1,
      "comment": "Start latches the request; Stop and the overload relay clear it.",
      "network": {
        "type": "series",
        "id": 2,
        "items": [
          {
            "type": "parallel",
            "id": 5,
            "branches": [
              {
                "type": "contact",
                "id": 3,
                "contact": "normallyOpen",
                "variable": "StartPB"
              },
              {
                "type": "contact",
                "id": 4,
                "contact": "normallyOpen",
                "variable": "Request"
              }
            ]
          },
          {
            "type": "contact",
            "id": 6,
            "contact": "normallyOpen",
            "variable": "StopPB"
          },
          {
            "type": "contact",
            "id": 7,
            "contact": "normallyOpen",
            "variable": "OverloadOK"
          }
        ]
      },
      "coils": [
        {
          "id": 8,
          "variable": "Request"
        }
      ]
    },
    {
      "id": 9,
      "comment": "The run lamp warns while the request is active.",
      "network": {
        "type": "series",
        "id": 10,
        "items": [
          {
            "type": "contact",
            "id": 11,
            "contact": "normallyOpen",
            "variable": "Request"
          }
        ]
      },
      "coils": [
        {
          "id": 12,
          "variable": "RunLamp"
        }
      ]
    },
    {
      "id": 13,
      "comment": "The motor starts 3 s after the request.",
      "network": {
        "type": "series",
        "id": 14,
        "items": [
          {
            "type": "contact",
            "id": 15,
            "contact": "normallyOpen",
            "variable": "Request"
          },
          {
            "type": "block",
            "id": 16,
            "block": "TON",
            "instance": "StartDelay",
            "preset": {
              "constant": "T#3s"
            }
          }
        ]
      },
      "coils": [
        {
          "id": 17,
          "variable": "MotorContactor"
        }
      ]
    }
  ]
}
