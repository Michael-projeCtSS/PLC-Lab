{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plclab.invalid/schemas/scene.schema.json",
  "title": "PLC Lab scene",
  "type": "object",
  "properties": {
    "format": {
      "const": "plclab-scene"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "object",
            "properties": {
              "type": {
                "enum": [
                  "pushButton",
                  "selectorSwitch",
                  "pilotLamp",
                  "motorStarter",
                  "onOffValve",
                  "pump",
                  "tank",
                  "levelSwitch",
                  "levelTransmitter",
                  "presenceSensor",
                  "variableFrequencyDrive"
                ]
              }
            },
            "additionalProperties": true,
            "required": [
              "type"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind"
        ]
      }
    },
    "couplings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "installation": {
      "type": "object"
    },
    "referenceStation": {
      "type": "object"
    },
    "network": {
      "type": "object"
    },
    "interface": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "$ref": "#/$defs/tag"
          },
          "type": {
            "enum": [
              "BOOL",
              "INT",
              "REAL",
              "TIME"
            ]
          },
          "direction": {
            "enum": [
              "input",
              "output"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "tag",
          "type",
          "direction",
          "description"
        ]
      }
    },
    "layout": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "$ref": "#/$defs/id"
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "component",
          "x",
          "y"
        ]
      }
    },
    "knowledgeRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "revision",
    "title",
    "summary",
    "components",
    "installation",
    "referenceStation"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    }
  }
}
