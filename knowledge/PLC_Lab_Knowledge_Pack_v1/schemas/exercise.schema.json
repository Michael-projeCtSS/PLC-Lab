{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plclab.invalid/schemas/exercise.schema.json",
  "title": "PLC Lab exercise",
  "type": "object",
  "properties": {
    "format": {
      "const": "plclab-exercise"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "practice",
        "troubleshooting"
      ]
    },
    "difficulty": {
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "scene": {
      "$ref": "#/$defs/id"
    },
    "platform": {
      "$ref": "#/$defs/id"
    },
    "starterProgram": {
      "type": "string",
      "minLength": 1
    },
    "starterStation": {
      "type": "object"
    },
    "requiredInterface": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "$ref": "#/$defs/tag"
          },
          "type": {
            "enum": [
              "BOOL",
              "INT",
              "REAL",
              "TIME"
            ]
          },
          "direction": {
            "enum": [
              "input",
              "output"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "tag",
          "type",
          "direction"
        ]
      }
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledgeRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/id"
          },
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "plcTag"
                  },
                  "tag": {
                    "$ref": "#/$defs/tag"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "tag"
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "const": "component"
                  },
                  "component": {
                    "$ref": "#/$defs/id"
                  },
                  "quantity": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "additionalProperties": false,
                "required": [
                  "type",
                  "component",
                  "quantity"
                ]
              }
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "name",
          "source"
        ]
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "durationMs": {
            "type": "integer",
            "minimum": 100,
            "maximum": 600000
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "atMs": {
                  "type": "integer",
                  "minimum": 0
                },
                "action": {
                  "type": "object"
                }
              },
              "additionalProperties": false,
              "required": [
                "atMs",
                "action"
              ]
            }
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "durationMs"
        ]
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "points": {
            "type": "integer",
            "minimum": 0
          },
          "scenario": {
            "$ref": "#/$defs/id"
          },
          "rule": {
            "$ref": "#/$defs/rule"
          },
          "onFail": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "points",
          "scenario",
          "rule",
          "onFail"
        ]
      }
    },
    "troubleshooting": {
      "type": "object",
      "properties": {
        "symptom": {
          "type": "string",
          "minLength": 1
        },
        "reportedBy": {
          "type": "string",
          "minLength": 1
        },
        "faults": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "fault": {
                "type": "object"
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "fault"
            ]
          }
        },
        "loadedProgram": {
          "type": "string",
          "minLength": 1
        },
        "diagnosisOptions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "label"
            ]
          }
        },
        "rootCauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "repairs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "clears": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            },
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "clears"
            ]
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "knowledgeRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "symptom",
        "reportedBy",
        "diagnosisOptions",
        "rootCauses",
        "verification"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "revision",
    "title",
    "kind",
    "difficulty",
    "summary",
    "objectives",
    "estimatedMinutes",
    "scene",
    "starterProgram",
    "requiredInterface",
    "instructions",
    "evidence",
    "scenarios",
    "criteria"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "all"
            },
            "of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "any"
            },
            "of": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/condition"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "not"
            },
            "of": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "of"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "compare"
            },
            "signal": {
              "$ref": "#/$defs/id"
            },
            "layer": {
              "enum": [
                "inputs",
                "outputs",
                "process",
                "next"
              ]
            },
            "op": {
              "enum": [
                "eq",
                "ne",
                "gt",
                "ge",
                "lt",
                "le"
              ]
            },
            "value": {
              "type": [
                "boolean",
                "number"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "signal",
            "layer",
            "op",
            "value"
          ]
        }
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "always"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "fromMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "never"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "eventually"
            },
            "condition": {
              "$ref": "#/$defs/condition"
            },
            "byMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition",
            "byMs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "respondsWithin"
            },
            "trigger": {
              "$ref": "#/$defs/condition"
            },
            "response": {
              "$ref": "#/$defs/condition"
            },
            "withinMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "trigger",
            "response",
            "withinMs"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "stateAt"
            },
            "atMs": {
              "type": "integer",
              "minimum": 0
            },
            "condition": {
              "$ref": "#/$defs/condition"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "atMs",
            "condition"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "noPlcFault"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "eventAbsent"
            },
            "event": {
              "enum": [
                "overflow",
                "dryRun",
                "highHigh",
                "lowLow",
                "motorOverload"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "event"
          ]
        }
      ]
    }
  }
}
