{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plclab.invalid/schemas/lesson.schema.json",
  "title": "PLC Lab lesson",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/id"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "type": "string",
      "minLength": 1
    },
    "minutes": {
      "type": "integer",
      "minimum": 1
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "concept",
              "visual",
              "example",
              "simulation",
              "task",
              "mistake",
              "challenge",
              "summary"
            ]
          },
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "code": {
            "type": "string"
          },
          "scene": {
            "$ref": "#/$defs/id"
          },
          "exercise": {
            "$ref": "#/$defs/id"
          },
          "question": {
            "$ref": "#/$defs/question"
          },
          "diagram": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "type",
          "heading",
          "body"
        ]
      }
    },
    "checkpoint": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "knowledgeRefs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "title",
    "summary",
    "level",
    "minutes",
    "objectives",
    "sections",
    "checkpoint"
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "question": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "answer": {
          "type": "integer",
          "minimum": 0
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "question",
        "options",
        "answer",
        "explanation"
      ]
    }
  }
}
