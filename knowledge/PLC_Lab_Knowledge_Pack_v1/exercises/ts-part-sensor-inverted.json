  "curriculumOrder": 3,
  "troubleshooting": {
    "symptom": "Since the proximity sensor was replaced, the batch lamp lights after one or two parts and the jam lamp is on while the belt is empty.",
    "reportedBy": "Line operator, packaging cell",
    "faults": [
      {
        "id": "sensor-nc",
        "fault": {
          "type": "contactTypeMismatch",
          "component": "prox",
          "installed": "normallyClosed"
        }
      }
    ],
    "diagnosisOptions": [
      {
        "id": "sensor-nc",
        "label": "The replacement sensor has the opposite switching function (normally closed)"
      },
      {
        "id": "sensor-range",
        "label": "The sensing distance is set too large"
      },
      {
        "id": "counter-logic",
        "label": "The counter logic is wrong"
      },
      {
        "id": "di-module",
        "label": "The digital input channel is defective"
      },
      {
        "id": "pnp-npn",
        "label": "The sensor is NPN instead of PNP"
      }
    ],
    "rootCauses": [
      "sensor-nc"
    ],
    "repairs": [
      {
        "id": "fit-no-sensor",
        "label": "Install a normally open (light-operated) sensor of the original type",
        "clears": [
          "sensor-nc"
        ]
      },
      {
        "id": "reduce-range",
        "label": "Reduce the sensing distance",
        "clears": []
      },
      {
        "id": "swap-channel",
        "label": "Move the sensor to a spare input channel",
        "clears": []
      }
    ],
    "verification": [
      "batch",
      "batch-early",
      "no-false-jam",
      "jam"
    ],
    "learningRefs": [
      "fundamentals.digital-io",
      "fundamentals.no-nc-contacts"
    ],
    "debriefRefs": [
      "troubleshooting.sensor-no-nc-assumption"
    ],
    "debrief": {
      "rootCause": "The replacement presence sensor has a normally closed (NC) output function. Its output is ON when nothing is in front of it, so the program saw a part on the empty belt and the inverse of every real part.",
      "evidence": [
        "PartPresent was TRUE with the belt empty and turned FALSE when a part reached the sensor.",
        "The batch counter counted as soon as AUTO was selected, without any part, because the inverted signal produced a rising edge.",
        "The jam lamp lit on an empty belt because the jam timer saw a permanently TRUE presence signal.",
        "The program was unchanged since before the sensor exchange, and the input channel followed the sensor faithfully."
      ],
      "repair": "Install a normally open sensor of the original type, then verify the batch count and the jam detection.",
      "reasoning": "After a device exchange, check the new device against the old data sheet first. An input that is permanently TRUE at rest and goes FALSE when the target appears is inverted, not defective."
    }
  }
