{
  "format": "plclab-exercise",
  "schemaVersion": 1,
  "id": "ex.tank-filling",
  "revision": 1,
  "title": "Fill a tank to the high level switch",
  "kind": "practice",
  "difficulty": "beginner",
  "summary": "Start opens the inlet valve and fills the tank. The valve must close when the high level switch becomes wet, and Stop closes it at any time. The tank must never overflow.",
  "objectives": [
    "Use a level switch to end a process step",
    "Prevent overflow with a stop condition"
  ],
  "estimatedMinutes": 20,
  "scene": "scene.tank-filling",
  "starterProgram": "PROGRAM Main\nVAR_INPUT\n    StartPB : BOOL; (* Start button S1 (normally open). *)\n    StopPB : BOOL; (* Stop button S2 (normally closed: TRUE while not pressed). *)\n    LevelLow : BOOL; (* TRUE while the level is below the low switch (LSL-104 contact closes when dry). *)\n    LevelHigh : BOOL; (* TRUE while the level is at or above the high switch (LSH-103 contact closes when wet). *)\n    InletOpen : BOOL; (* Inlet valve fully-open limit switch. *)\n    LevelRaw : INT; (* Raw analog value of LT-105 (scaling depends on the selected platform profile). *)\nEND_VAR\nVAR_OUTPUT\n    InletValve : BOOL; (* Inlet valve solenoid XV-101: TRUE opens the valve. *)\n    DrainPump : BOOL; (* Drain pump P-102 contactor. *)\nEND_VAR\nVAR\n    Filling : BOOL;\nEND_VAR\n\n(* Fill the tank with InletValve until LevelHigh. Stop closes the valve. *)\n\nEND_PROGRAM\n",
  "requiredInterface": [
    {
      "tag": "StartPB",
      "type": "BOOL",
      "direction": "input"
    },
    {
      "tag": "StopPB",
      "type": "BOOL",
      "direction": "input"
    },
    {
      "tag": "LevelHigh",
      "type": "BOOL",
      "direction": "input"
    },
    {
      "tag": "InletValve",
      "type": "BOOL",
      "direction": "output"
    },
    {
      "tag": "DrainPump",
      "type": "BOOL",
      "direction": "output"
    }
  ],
  "instructions": [
    "Start latches filling: InletValve opens.",
    "When LevelHigh becomes TRUE, InletValve closes.",
    "Stop (StopPB FALSE) closes the valve immediately.",
    "The drain pump stays off in this exercise."
  ],
  "hints": [
    "Use a latch like the motor seal-in: Filling := (StartPB OR Filling) AND StopPB AND NOT LevelHigh;",
    "The valve needs 1.5 s to open and close; the level keeps rising while it closes."
  ],
  "knowledgeRefs": [
    "fundamentals.start-stop-latch",
    "fundamentals.interlocks"
  ],
