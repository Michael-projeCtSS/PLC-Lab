      }
    }
  ],
  "scenarios": [
    {
      "id": "fill",
      "title": "Fill to the high level",
      "durationMs": 20000,
      "actions": [
        {
          "atMs": 0,
          "action": {
            "type": "setPlcMode",
            "mode": "run"
          }
