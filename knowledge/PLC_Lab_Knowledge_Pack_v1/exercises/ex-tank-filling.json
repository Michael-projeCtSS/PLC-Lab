  "criteria": [
    {
      "id": "opens",
      "title": "Start opens the inlet valve",
      "points": 20,
      "scenario": "fill",
      "rule": {
        "type": "respondsWithin",
        "trigger": {
          "type": "compare",
          "signal": "start",
          "layer": "inputs",
          "op": "eq",
          "value": true
        },
        "response": {
          "type": "compare",
          "signal": "valve",
          "layer": "outputs",
          "op": "eq",
          "value": true
        },
        "withinMs": 200
      },
      "onFail": "InletValve did not open after Start."
    },
    {
      "id": "reaches",
      "title": "The tank fills to the high switch",
      "points": 20,
      "scenario": "fill",
      "rule": {
        "type": "eventually",
        "condition": {
          "type": "compare",
          "signal": "high",
          "layer": "inputs",
          "op": "eq",
          "value": true
        },
        "byMs": 16000
      },
      "onFail": "The high level switch was never reached."
    },
    {
      "id": "closes",
      "title": "The valve closes at the high level",
      "points": 30,
      "scenario": "fill",
      "rule": {
        "type": "respondsWithin",
        "trigger": {
          "type": "compare",
          "signal": "high",
          "layer": "inputs",
          "op": "eq",
          "value": true
        },
        "response": {
          "type": "compare",
          "signal": "valve",
          "layer": "outputs",
          "op": "eq",
          "value": false
        },
        "withinMs": 200
      },
      "onFail": "InletValve stayed open after LevelHigh."
    },
    {
      "id": "no-overflow",
      "title": "No overflow",
      "points": 10,
      "scenario": "fill",
      "rule": {
        "type": "eventAbsent",
        "event": "overflow"
      },
      "onFail": "The tank overflowed."
    },
    {
      "id": "stop",
      "title": "Stop closes the valve",
      "points": 10,
      "scenario": "stop",
      "rule": {
        "type": "stateAt",
        "atMs": 3600,
        "condition": {
          "type": "compare",
          "signal": "valve",
          "layer": "outputs",
          "op": "eq",
          "value": false
        }
      },
      "onFail": "InletValve stayed open after Stop."
    },
    {
      "id": "pump-off",
      "title": "The drain pump stays off",
      "points": 10,
      "scenario": "fill",
      "rule": {
        "type": "never",
        "condition": {
          "type": "compare",
          "signal": "pump",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "DrainPump was switched on."
    }
  ],
  "curriculumOrder": 6
