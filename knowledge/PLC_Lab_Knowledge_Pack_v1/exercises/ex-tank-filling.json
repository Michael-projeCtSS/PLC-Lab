          }
        },
        {
          "atMs": 800,
          "action": {
            "type": "release",
            "component": "start"
          }
        }
      ]
    },
    {
      "id": "stop",
      "title": "Stop while filling",
      "durationMs": 6000,
      "actions": [
        {
          "atMs": 0,
          "action": {
            "type": "setPlcMode",
            "mode": "run"
          }
        },
        {
          "atMs": 500,
          "action": {
            "type": "press",
            "component": "start"
          }
        },
        {
          "atMs": 800,
          "action": {
            "type": "release",
            "component": "start"
          }
        },
        {
          "atMs": 3000,
          "action": {
            "type": "press",
            "component": "stop"
          }
        },
        {
          "atMs": 3300,
          "action": {
            "type": "release",
            "component": "stop"
          }
        }
      ]
