  "criteria": [
    {
      "id": "counting",
      "title": "Lamp1 shows counting in AUTO",
      "points": 10,
      "scenario": "batch",
      "rule": {
        "type": "stateAt",
        "atMs": 400,
        "condition": {
          "type": "compare",
          "signal": "lamp1",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "Lamp1 was off in AUTO before any part."
    },
    {
      "id": "counts",
      "title": "The counter counts the parts",
      "points": 15,
      "scenario": "batch",
      "rule": {
        "type": "stateAt",
        "atMs": 2100,
        "condition": {
          "type": "compare",
          "signal": "count",
          "layer": "outputs",
          "op": "eq",
          "value": 3
        }
      },
      "onFail": "Count was not 3 after three parts."
    },
    {
      "id": "last-part",
      "title": "Lamp3 announces the last part",
      "points": 15,
      "scenario": "batch",
      "rule": {
        "type": "stateAt",
        "atMs": 2700,
        "condition": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "lamp3",
              "layer": "outputs",
              "op": "eq",
              "value": true
            },
            {
              "type": "compare",
              "signal": "lamp2",
              "layer": "outputs",
              "op": "eq",
              "value": false
            }
          ]
        }
      },
      "onFail": "After four parts Lamp3 should be on and Lamp2 still off."
    },
    {
      "id": "batch",
      "title": "Lamp2 after the fifth part; counting stops",
      "points": 25,
      "scenario": "batch",
      "rule": {
        "type": "stateAt",
        "atMs": 3500,
        "condition": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "lamp2",
              "layer": "outputs",
              "op": "eq",
              "value": true
            },
            {
              "type": "compare",
              "signal": "lamp1",
              "layer": "outputs",
              "op": "eq",
              "value": false
            },
            {
              "type": "compare",
              "signal": "lamp3",
              "layer": "outputs",
              "op": "eq",
              "value": false
            }
          ]
        }
      },
      "onFail": "After five parts: Lamp2 on, Lamp1 off and Lamp3 off."
    },
    {
      "id": "next-batch",
      "title": "Button2 starts the next batch",
      "points": 20,
      "scenario": "batch",
      "rule": {
        "type": "stateAt",
        "atMs": 4600,
        "condition": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "lamp2",
              "layer": "outputs",
              "op": "eq",
              "value": false
            },
            {
              "type": "compare",
              "signal": "lamp1",
              "layer": "outputs",
              "op": "eq",
              "value": true
            },
            {
              "type": "compare",
              "signal": "count",
              "layer": "outputs",
              "op": "eq",
              "value": 0
            }
          ]
        }
      },
      "onFail": "After Button2 the count should be 0, Lamp2 off and Lamp1 on."
    },
    {
      "id": "manual",
      "title": "No counting in MAN",
      "points": 15,
