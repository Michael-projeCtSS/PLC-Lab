  "criteria": [
    {
      "id": "mode-lamp",
      "title": "Lamp1 shows AUTO",
      "points": 10,
      "scenario": "auto",
      "rule": {
        "type": "stateAt",
        "atMs": 1000,
        "condition": {
          "type": "compare",
          "signal": "lamp1",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "Lamp1 was off in AUTO."
    },
    {
      "id": "batch",
      "title": "Batch lamp after four parts",
      "points": 35,
      "scenario": "auto",
      "rule": {
        "type": "stateAt",
        "atMs": 3200,
        "condition": {
          "type": "compare",
          "signal": "batch",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "Lamp2 was off after four parts in AUTO."
    },
    {
      "id": "batch-early",
      "title": "No batch lamp before the fourth part",
      "points": 15,
      "scenario": "auto",
      "rule": {
        "type": "stateAt",
        "atMs": 2100,
        "condition": {
          "type": "compare",
          "signal": "batch",
          "layer": "outputs",
          "op": "eq",
          "value": false
        }
      },
      "onFail": "Lamp2 lit before the fourth part."
    },
    {
      "id": "manual",
      "title": "Parts are not counted in MAN",
      "points": 15,
      "scenario": "manual",
      "rule": {
        "type": "never",
        "condition": {
          "type": "compare",
          "signal": "batch",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "Parts were counted with the selector in MAN."
    },
    {
      "id": "no-false-jam",
      "title": "Normal parts do not raise a jam",
      "points": 10,
      "scenario": "auto",
      "rule": {
        "type": "never",
        "condition": {
          "type": "compare",
          "signal": "jam",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "Lamp3 (jam) lit although every part passed quickly."
    },
    {
      "id": "jam",
      "title": "A blocked sensor raises a jam after 2 s",
      "points": 15,
      "scenario": "jam",
      "rule": {
        "type": "stateAt",
        "atMs": 3000,
        "condition": {
          "type": "compare",
          "signal": "jam",
          "layer": "outputs",
          "op": "eq",
          "value": true
        }
      },
      "onFail": "Lamp3 did not light when a part blocked the sensor for more than 2 s."
    }
