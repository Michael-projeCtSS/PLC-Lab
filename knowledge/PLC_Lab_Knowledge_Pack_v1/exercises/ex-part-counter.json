{
  "format": "plclab-exercise",
  "schemaVersion": 1,
  "id": "ex.part-counter",
  "revision": 1,
  "title": "Conveyor part counter with jam detection",
  "kind": "practice",
  "difficulty": "intermediate",
  "summary": "A proximity sensor sees parts passing on a conveyor. In AUTO mode count parts in batches of four and detect a jam when a part stays in front of the sensor for more than two seconds.",
  "objectives": [
    "Combine a mode selector, a counter and a timer",
    "Detect abnormal states from timing"
  ],
  "estimatedMinutes": 25,
  "scene": "scene.io-basics",
  "starterProgram": "PROGRAM Main\nVAR_INPUT\n    Button1 : BOOL; (* Pushbutton S1, normally open. *)\n    Button2 : BOOL; (* Pushbutton S2, normally open. *)\n    AutoMode : BOOL; (* Selector S3 in position AUTO. *)\n    PartPresent : BOOL; (* Proximity sensor B1 detects a part. *)\nEND_VAR\nVAR_OUTPUT\n    Lamp1 : BOOL; (* Green lamp H1. *)\n    Lamp2 : BOOL; (* Amber lamp H2. *)\n    Lamp3 : BOOL; (* Red lamp H3. *)\nEND_VAR\nVAR\n    Parts : CTU;\n    Jam : TON;\nEND_VAR\n\n(* Count parts in AUTO, batch lamp at 4, jam lamp after 2 s of continuous detection. *)\n\nEND_PROGRAM\n",
  "requiredInterface": [
    {
      "tag": "AutoMode",
      "type": "BOOL",
      "direction": "input"
    },
    {
      "tag": "PartPresent",
      "type": "BOOL",
      "direction": "input"
    },
    {
      "tag": "Button2",
      "type": "BOOL",
      "direction": "input"
    },
    {
      "tag": "Lamp1",
      "type": "BOOL",
      "direction": "output"
    },
    {
      "tag": "Lamp2",
      "type": "BOOL",
      "direction": "output"
    },
    {
      "tag": "Lamp3",
      "type": "BOOL",
      "direction": "output"
    }
  ],
  "instructions": [
    "Lamp1 shows that the selector is in AUTO.",
    "In AUTO, count parts seen by the proximity sensor (PartPresent). Lamp2 lights after four parts. Button2 resets the count.",
    "In MAN, parts are not counted.",
    "Lamp3 (jam) lights when PartPresent stays TRUE for more than 2 s in AUTO.",
    "Change the part presence by clicking the sensor in the Process view."
  ],
  "hints": [
    "Count only in AUTO: CU := PartPresent AND AutoMode",
    "A TON on PartPresent detects how long a part stays in front of the sensor."
  ],
  "knowledgeRefs": [
    "instruction.ctu",
    "instruction.ton"
  ],
