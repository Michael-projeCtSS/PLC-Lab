  "criteria": [
    {
      "id": "starts",
      "title": "Start opens the inlet valve step",
      "points": 10,
      "scenario": "batch",
      "rule": {
        "type": "sequenceReached",
        "step": "fill",
        "byMs": 3500
      },
      "onFail": "The sequence did not reach the fill step within 3.5 s after Start."
    },
    {
      "id": "completes",
      "title": "The batch completes",
      "points": 20,
      "scenario": "batch",
      "rule": {
        "type": "sequenceReached",
        "step": "complete",
        "byMs": 40000
      },
      "onFail": "The batch did not reach step 5 (complete) within 40 s."
    },
    {
      "id": "conforms",
      "title": "The program follows the documented sequence",
      "points": 15,
      "scenario": "batch",
      "rule": {
        "type": "sequenceConforms"
      },
      "onFail": "The sequence monitor recorded a deviation or a step timeout."
    },
    {
      "id": "exclusive",
      "title": "Inlet valve and drain pump never run together",
      "points": 10,
      "scenario": "batch",
      "rule": {
        "type": "never",
        "condition": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "valve",
              "layer": "outputs",
              "op": "eq",
              "value": true
            },
            {
              "type": "compare",
              "signal": "pump",
              "layer": "outputs",
              "op": "eq",
              "value": true
            }
          ]
        }
      },
      "onFail": "InletValve and DrainPump were on together."
    },
    {
      "id": "no-overflow",
      "title": "No overflow",
      "points": 5,
      "scenario": "batch",
      "rule": {
        "type": "eventAbsent",
        "event": "overflow"
      },
      "onFail": "The tank overflowed."
    },
    {
      "id": "refuses",
      "title": "A pressed Hold button refuses the start",
      "points": 10,
      "scenario": "refused",
      "rule": {
        "type": "stateAt",
        "atMs": 2000,
        "condition": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "step",
              "layer": "outputs",
              "op": "eq",
              "value": 0
            },
            {
              "type": "compare",
              "signal": "valve",
              "layer": "outputs",
              "op": "eq",
              "value": false
            }
          ]
        }
      },
      "onFail": "The batch started although the Hold button was pressed."
    },
    {
      "id": "holds",
      "title": "HOLD keeps the step and stops the plant",
      "points": 10,
      "scenario": "hold",
      "rule": {
        "type": "stateAt",
        "atMs": 8000,
        "condition": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "held",
              "layer": "outputs",
              "op": "eq",
              "value": true
            },
            {
              "type": "compare",
              "signal": "step",
              "layer": "outputs",
              "op": "eq",
              "value": 2
            },
            {
              "type": "compare",
              "signal": "valve",
              "layer": "outputs",
              "op": "eq",
              "value": false
            },
            {
              "type": "compare",
              "signal": "pump",
              "layer": "outputs",
              "op": "eq",
              "value": false
            }
          ]
        }
      },
      "onFail": "During HOLD the sequence did not stay in the fill step with both outputs off."
    },
    {
      "id": "resumes",
      "title": "Start resumes the held batch",
      "points": 10,
      "scenario": "hold",
      "rule": {
        "type": "sequenceReached",
        "step": "complete",
        "byMs": 55000
      },
      "onFail": "After Start the held batch did not continue to step 5."
    },
    {
      "id": "hold-conforms",
      "title": "Nothing advances while held",
      "points": 5,
      "scenario": "hold",
      "rule": {
        "type": "sequenceConforms"
      },
      "onFail": "The sequence monitor recorded a deviation during or after HOLD."
    },
    {
      "id": "aborts",
      "title": "Stop aborts the batch at once",
      "points": 5,
      "scenario": "stop",
      "rule": {
        "type": "respondsWithin",
        "trigger": {
          "type": "compare",
          "signal": "stop",
          "layer": "inputs",
          "op": "eq",
          "value": false
        },
        "response": {
          "type": "all",
          "of": [
            {
              "type": "compare",
              "signal": "step",
              "layer": "outputs",
              "op": "eq",
              "value": 0
            },
            {
              "type": "compare",
              "signal": "valve",
              "layer": "outputs",
              "op": "eq",
              "value": false
            }
          ]
        },
        "withinMs": 200
      },
      "onFail": "Stop did not return the sequence to step 0 with the valve closed within 200 ms."
    }
  ]
}
