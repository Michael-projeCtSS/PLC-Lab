{
  "format": "plclab-exercise",
  "schemaVersion": 1,
  "id": "ex.tank-sequence",
  "revision": 1,
  "title": "Batch sequence with permissives, interlocks and HOLD",
  "kind": "practice",
  "difficulty": "intermediate",
  "summary": "Program the tank batch as a documented step sequence: open the inlet, fill, close the inlet, drain, complete. Start is refused unless its permissives hold, interlocks protect the plant, Hold pauses a running step and Stop aborts. The sequence inspector shows what each step waits for.",
  "objectives": [
    "Program a step sequence with permissives, interlocks, HOLD and RESUME",
    "Read the sequence inspector to find what a step is waiting for"
  ],
  "prerequisites": [
    "ex.tank-batch-sequence"
  ],
  "estimatedMinutes": 40,
  "scene": "scene.tank-filling",
  "starterProgram": "PROGRAM Main\nVAR_INPUT\n    StartPB : BOOL; (* Start button S1 (normally open). *)\n    StopPB : BOOL; (* Stop button S2 (normally closed: TRUE while not pressed). *)\n    HoldPB : BOOL; (* Hold button S3 (normally open). *)\n    LevelLow : BOOL; (* TRUE while the level is below the low switch (LSL-104 contact closes when dry). *)\n    LevelHigh : BOOL; (* TRUE while the level is at or above the high switch (LSH-103 contact closes when wet). *)\n    InletOpen : BOOL; (* Inlet valve fully-open limit switch. *)\nEND_VAR\nVAR_OUTPUT\n    InletValve : BOOL; (* Inlet valve solenoid XV-101: TRUE opens the valve. *)\n    DrainPump : BOOL; (* Drain pump P-102 contactor. *)\nEND_VAR\nVAR\n    Step : INT; (* Active step: 0 idle, 1 open inlet, 2 fill, 3 close inlet, 4 drain, 5 complete. *)\n    Held : BOOL; (* TRUE while the sequence is held. *)\nEND_VAR\n\n(* Write the sequence: CASE Step OF ... END_CASE; then the outputs from Step and Held. *)\n\nEND_PROGRAM\n",
