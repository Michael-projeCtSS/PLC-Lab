  "sequence": {
    "id": "tank-batch",
    "name": "Tank batch",
    "stepSignal": "step",
    "heldSignal": "held",
    "steps": [
      {
        "id": "idle",
        "number": 0,
        "name": "Idle",
        "role": "initial"
      },
      {
        "id": "open-inlet",
        "number": 1,
        "name": "Open the inlet valve",
        "timeoutMs": 5000
      },
      {
        "id": "fill",
        "number": 2,
        "name": "Fill the tank",
        "timeoutMs": 30000
      },
      {
        "id": "close-inlet",
        "number": 3,
        "name": "Close the inlet valve",
        "timeoutMs": 5000
      },
      {
        "id": "drain",
        "number": 4,
        "name": "Drain the tank",
        "timeoutMs": 40000
      },
      {
        "id": "complete",
        "number": 5,
        "name": "Batch complete",
        "role": "final"
      }
    ],
    "transitions": [
      {
        "id": "start",
        "from": "idle",
        "to": "open-inlet",
        "name": "Start requested",
        "condition": {
          "type": "compare",
          "signal": "start",
          "layer": "inputs",
          "op": "eq",
          "value": true
        },
        "permissives": [
          {
            "id": "stop-released",
            "name": "Stop button released",
            "condition": {
              "type": "compare",
              "signal": "stop",
              "layer": "inputs",
              "op": "eq",
              "value": true
            }
          },
          {
            "id": "hold-released",
            "name": "Hold button released",
            "condition": {
              "type": "compare",
              "signal": "hold",
              "layer": "inputs",
              "op": "eq",
              "value": false
            }
          },
          {
            "id": "tank-not-full",
            "name": "Tank below the high level switch",
            "condition": {
              "type": "compare",
              "signal": "high",
              "layer": "inputs",
              "op": "eq",
              "value": false
            }
          }
        ]
      },
      {
        "id": "opened",
        "from": "open-inlet",
        "to": "fill",
        "name": "Inlet valve reports open",
        "condition": {
          "type": "compare",
          "signal": "open",
          "layer": "inputs",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "full",
        "from": "fill",
        "to": "close-inlet",
        "name": "High level reached",
        "condition": {
          "type": "compare",
          "signal": "high",
          "layer": "inputs",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "closed",
        "from": "close-inlet",
        "to": "drain",
        "name": "Inlet valve left the open position",
        "condition": {
          "type": "compare",
          "signal": "open",
          "layer": "inputs",
          "op": "eq",
          "value": false
        }
      },
      {
        "id": "empty",
        "from": "drain",
        "to": "complete",
        "name": "Low level reached",
        "condition": {
          "type": "compare",
          "signal": "low",
          "layer": "inputs",
          "op": "eq",
          "value": true
        }
      },
      {
        "id": "next-batch",
        "from": "complete",
        "to": "idle",
        "name": "Start for the next batch",
        "condition": {
          "type": "compare",
          "signal": "start",
          "layer": "inputs",
          "op": "eq",
          "value": true
        }
      }
    ],
    "interlocks": [
      {
        "id": "inlet-not-closed",
        "name": "Inlet valve not closed",
        "condition": {
          "type": "compare",
          "signal": "open",
          "layer": "inputs",
          "op": "eq",
          "value": true
        },
        "reaction": "blockStart",
        "steps": [
          "idle"
        ]
      },
      {
        "id": "tank-empty",
        "name": "Tank at the low level: do not drain",
        "condition": {
          "type": "compare",
          "signal": "low",
          "layer": "inputs",
          "op": "eq",
          "value": true
        },
        "reaction": "holdProgress",
        "steps": [
          "close-inlet"
        ]
      },
      {
        "id": "stop-pressed",
        "name": "Stop pressed",
        "condition": {
          "type": "compare",
          "signal": "stop",
          "layer": "inputs",
          "op": "eq",
          "value": false
        },
        "reaction": "abortSequence",
        "steps": [
          "open-inlet",
          "fill",
          "close-inlet",
          "drain"
        ],
        "reactionMs": 200
      }
    ]
  },
