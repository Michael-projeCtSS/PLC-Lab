  "interface": [
    {
      "tag": "StartPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Start button S1, normally open: TRUE while pressed."
    },
    {
      "tag": "StopPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Stop button S2, normally closed: TRUE while NOT pressed."
    },
    {
      "tag": "LevelHigh",
      "type": "BOOL",
      "direction": "input",
      "description": "High level switch LSH-205 (normally open): TRUE when wet (safety stop)."
    },
    {
      "tag": "InletOpen",
      "type": "BOOL",
      "direction": "input",
      "description": "Inlet valve XV-201 open limit switch."
    },
    {
      "tag": "LevelRaw",
      "type": "INT",
      "direction": "input",
      "description": "LT-203 hydrostatic level transmitter, 4-20 mA, 2-wire: raw value (generic profile 0..10000 = 0..100 %)."
    },
    {
      "tag": "CheckRaw",
      "type": "INT",
      "direction": "input",
      "description": "LT-204 ultrasonic level sensor, 0-10 V: raw value of the cross-check measurement (generic profile 0..10000 = 0..100 %)."
    },
    {
      "tag": "InletValve",
      "type": "BOOL",
      "direction": "output",
      "description": "Inlet valve XV-201 solenoid: TRUE opens the valve."
    },
    {
      "tag": "DrainPump",
      "type": "BOOL",
      "direction": "output",
      "description": "Drain pump P-202 contactor."
    }
