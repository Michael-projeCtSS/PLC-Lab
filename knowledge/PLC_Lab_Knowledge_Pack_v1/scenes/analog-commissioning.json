{
  "format": "plclab-scene",
  "schemaVersion": 1,
  "id": "scene.analog-commissioning",
  "revision": 1,
  "title": "Analog commissioning bench",
  "summary": "A buffer tank before handover: an inlet valve and a drain pump, a 2-wire 4-20 mA hydrostatic level transmitter for control, a 0-10 V ultrasonic level sensor as a cross-check, a high level switch for safety, and a compact PLC with a 4-channel analog input module.",
  "components": [
    {
      "id": "start",
      "label": "Start S1",
      "kind": {
        "type": "pushButton",
        "contact": "normallyOpen",
        "color": "green"
      }
    },
    {
      "id": "stop",
      "label": "Stop S2",
      "kind": {
        "type": "pushButton",
        "contact": "normallyClosed",
        "color": "red"
      }
    },
    {
      "id": "inlet",
      "label": "Inlet valve XV-201",
      "kind": {
        "type": "onOffValve",
        "travelMs": 1500,
        "flowMlPerS": 8000
      }
    },
    {
      "id": "pump",
      "label": "Drain pump P-202",
      "kind": {
        "type": "pump",
        "flowMlPerS": 5000
      }
    },
    {
      "id": "tank",
      "label": "Tank T-200",
      "kind": {
        "type": "tank",
        "capacityMl": 100000,
        "initialMl": 20000,
        "highHighMl": 97000,
        "lowLowMl": 5000
      }
    },
    {
      "id": "lsh",
      "label": "High level switch LSH-205",
      "kind": {
        "type": "levelSwitch",
        "tank": "tank",
        "switchLevelMl": 95000,
        "contact": "normallyOpen",
        "output": "pnp"
      }
    },
    {
      "id": "lt1",
      "label": "Level transmitter LT-203",
      "kind": {
        "type": "levelTransmitter",
        "tank": "tank",
        "rangeMinMl": 0,
        "rangeMaxMl": 100000,
        "signal": "current4To20mA",
        "wiring": "twoWire"
      }
    },
    {
      "id": "lt2",
      "label": "Level sensor LT-204",
      "kind": {
        "type": "levelTransmitter",
        "tank": "tank",
        "rangeMinMl": 0,
        "rangeMaxMl": 100000,
        "signal": "voltage0To10V",
        "wiring": "fourWire"
      }
    }
  ],
  "couplings": [
    {
      "type": "valveFillsTank",
      "valve": "inlet",
      "tank": "tank"
    },
    {
      "type": "pumpDrainsTank",
      "pump": "pump",
      "tank": "tank"
    }
  ],
  "installation": {
    "cpu": "cpu.compact",
    "modules": [
      {
        "position": {
          "rack": 0,
          "slot": 1
        },
        "module": "di8.24vdc.sink"
      },
      {
        "position": {
          "rack": 0,
          "slot": 2
        },
        "module": "do8.24vdc"
      },
      {
        "position": {
          "rack": 0,
          "slot": 3
        },
        "module": "ai4.ui"
      }
    ],
    "wiring": [
      {
        "channel": {
          "rack": 0,
          "slot": 1,
          "channel": 0
        },
        "component": "start",
        "port": "contact"
      },
      {
        "channel": {
          "rack": 0,
          "slot": 1,
          "channel": 1
        },
        "component": "stop",
        "port": "contact"
      },
      {
        "channel": {
          "rack": 0,
