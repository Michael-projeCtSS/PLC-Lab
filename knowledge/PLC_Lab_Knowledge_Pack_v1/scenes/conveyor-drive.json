{
  "format": "plclab-scene",
  "schemaVersion": 1,
  "id": "scene.conveyor-drive",
  "revision": 1,
  "title": "Conveyor with variable frequency drive",
  "summary": "A conveyor motor fed by a variable frequency drive. The PLC switches the drive's run terminal and reads three relay outputs of the drive: ready, running and remote control active. A normally open start button, a normally closed stop button and a run lamp are wired to a compact PLC.",
  "components": [
    { "id": "start", "label": "Start S1", "kind": { "type": "pushButton", "contact": "normallyOpen", "color": "green" } },
    { "id": "stop", "label": "Stop S2", "kind": { "type": "pushButton", "contact": "normallyClosed", "color": "red" } },
    { "id": "drive", "label": "Conveyor drive U1 / motor M1", "kind": { "type": "variableFrequencyDrive", "rampMs": 2000, "ratedCurrentMa": 3800 } },
    { "id": "lamp", "label": "Run lamp H1", "kind": { "type": "pilotLamp", "color": "green" } }
  ],
  "installation": {
    "cpu": "cpu.compact",
    "modules": [
      { "position": { "rack": 0, "slot": 1 }, "module": "di8.24vdc.sink" },
      { "position": { "rack": 0, "slot": 2 }, "module": "do8.24vdc" }
    ],
    "wiring": [
      { "channel": { "rack": 0, "slot": 1, "channel": 0 }, "component": "start", "port": "contact" },
      { "channel": { "rack": 0, "slot": 1, "channel": 1 }, "component": "stop", "port": "contact" },
      { "channel": { "rack": 0, "slot": 1, "channel": 2 }, "component": "drive", "port": "ready" },
      { "channel": { "rack": 0, "slot": 1, "channel": 3 }, "component": "drive", "port": "running" },
      { "channel": { "rack": 0, "slot": 1, "channel": 4 }, "component": "drive", "port": "remote" },
      { "channel": { "rack": 0, "slot": 2, "channel": 0 }, "component": "drive", "port": "run" },
      { "channel": { "rack": 0, "slot": 2, "channel": 1 }, "component": "lamp", "port": "coil" }
    ]
  },
  "referenceStation": {
    "name": "PLC_1",
    "cpu": "cpu.compact",
    "modules": [
      { "position": { "rack": 0, "slot": 1 }, "module": "di8.24vdc.sink", "startAddress": 0 },
      { "position": { "rack": 0, "slot": 2 }, "module": "do8.24vdc", "startAddress": 0 }
    ],
    "ioMap": [
      { "channel": { "rack": 0, "slot": 1, "channel": 0 }, "tag": "StartPB" },
      { "channel": { "rack": 0, "slot": 1, "channel": 1 }, "tag": "StopPB" },
      { "channel": { "rack": 0, "slot": 1, "channel": 2 }, "tag": "DriveReady" },
      { "channel": { "rack": 0, "slot": 1, "channel": 3 }, "tag": "DriveRunning" },
      { "channel": { "rack": 0, "slot": 1, "channel": 4 }, "tag": "DriveRemote" },
      { "channel": { "rack": 0, "slot": 2, "channel": 0 }, "tag": "DriveRun" },
      { "channel": { "rack": 0, "slot": 2, "channel": 1 }, "tag": "RunLamp" }
    ]
  },
  "interface": [
    { "tag": "StartPB", "type": "BOOL", "direction": "input", "description": "Start button S1, normally open: TRUE while pressed." },
    { "tag": "StopPB", "type": "BOOL", "direction": "input", "description": "Stop button S2, normally closed: TRUE while NOT pressed (wire-break safe)." },
    { "tag": "DriveReady", "type": "BOOL", "direction": "input", "description": "Drive relay output 'ready': TRUE while the drive is powered and not tripped." },
    { "tag": "DriveRunning", "type": "BOOL", "direction": "input", "description": "Drive relay output 'running': TRUE while the drive is turning the motor." },
    { "tag": "DriveRemote", "type": "BOOL", "direction": "input", "description": "Drive relay output 'remote': TRUE while the drive accepts its run terminal (remote/terminal control)." },
    { "tag": "DriveRun", "type": "BOOL", "direction": "output", "description": "Drive run terminal: TRUE requests the drive to run." },
    { "tag": "RunLamp", "type": "BOOL", "direction": "output", "description": "Green run lamp H1." }
  ],
  "layout": [
    { "component": "start", "x": 120, "y": 420 },
    { "component": "stop", "x": 240, "y": 420 },
    { "component": "lamp", "x": 360, "y": 420 },
    { "component": "drive", "x": 560, "y": 240, "width": 300, "height": 170 }
  ],
  "knowledgeRefs": ["fundamentals.drives-basics", "fundamentals.start-stop-latch"]
}
