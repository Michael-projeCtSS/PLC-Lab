  "interface": [
    {
      "tag": "StartPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Start button S1, normally open: TRUE while pressed."
    },
    {
      "tag": "StopPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Stop button S2, normally closed: TRUE while NOT pressed (wire-break safe)."
    },
    {
      "tag": "GuardClosed",
      "type": "BOOL",
      "direction": "input",
      "description": "Guard door switch B2 (PNP, normally open): TRUE while the guard door is closed."
    },
    {
      "tag": "PartAtEnd",
      "type": "BOOL",
      "direction": "input",
      "description": "Part sensor B1 at the conveyor end (PNP, normally open): TRUE while a part is there."
    },
    {
      "tag": "MotorFeedback",
      "type": "BOOL",
      "direction": "input",
      "description": "Contactor K1 auxiliary contact: TRUE when the contactor has pulled in."
    },
    {
      "tag": "OverloadOK",
      "type": "BOOL",
      "direction": "input",
      "description": "Overload relay F1, normally closed: TRUE while the motor is not overloaded."
    },
    {
      "tag": "ValveOpen",
      "type": "BOOL",
      "direction": "input",
      "description": "Cooling valve Y1 open limit switch: TRUE when fully open."
    },
    {
      "tag": "ValveClosed",
      "type": "BOOL",
      "direction": "input",
      "description": "Cooling valve Y1 closed limit switch: TRUE when fully closed."
    },
    {
      "tag": "MotorContactor",
      "type": "BOOL",
      "direction": "output",
      "description": "Contactor coil K1: TRUE runs the conveyor motor M1."
    },
    {
      "tag": "CoolingValve",
      "type": "BOOL",
      "direction": "output",
      "description": "Cooling valve solenoid Y1: TRUE opens the valve."
    },
    {
      "tag": "RunLamp",
      "type": "BOOL",
      "direction": "output",
      "description": "Green lamp H1: the machine runs (motor feedback and valve open)."
    }
  ],
