{
  "format": "plclab-scene",
  "schemaVersion": 1,
  "id": "scene.dio-commissioning",
  "revision": 1,
  "title": "Digital I/O commissioning bench",
  "summary": "A newly installed conveyor cell before handover: start and stop buttons, a guard door switch, a part sensor, a motor contactor with auxiliary feedback and overload relay, a cooling valve with open and closed limit switches and a run lamp, wired to a compact PLC with a 16-channel input module and an 8-channel output module.",
  "components": [
    {
      "id": "start",
      "label": "Start S1",
      "kind": {
        "type": "pushButton",
        "contact": "normallyOpen",
        "color": "green"
      }
    },
    {
      "id": "stop",
      "label": "Stop S2",
      "kind": {
        "type": "pushButton",
        "contact": "normallyClosed",
        "color": "red"
      }
    },
    {
      "id": "guard",
      "label": "Guard door B2",
      "kind": {
        "type": "presenceSensor",
        "output": "pnp",
        "contact": "normallyOpen"
      }
    },
    {
      "id": "part",
      "label": "Part sensor B1",
      "kind": {
        "type": "presenceSensor",
        "output": "pnp",
        "contact": "normallyOpen"
      }
    },
    {
      "id": "motor",
      "label": "Conveyor motor M1 (K1, F1)",
      "kind": {
        "type": "motorStarter",
        "pickupMs": 30,
        "runUpMs": 1500,
        "ratedCurrentMa": 4200
      }
    },
    {
      "id": "valve",
      "label": "Cooling valve Y1",
      "kind": {
        "type": "onOffValve",
        "travelMs": 800,
        "flowMlPerS": 0
      }
    },
    {
      "id": "lamp",
      "label": "Run lamp H1",
      "kind": {
        "type": "pilotLamp",
        "color": "green"
      }
    }
  ],
