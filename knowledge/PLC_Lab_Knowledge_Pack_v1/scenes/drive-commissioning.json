{
  "format": "plclab-scene",
  "schemaVersion": 1,
  "id": "scene.drive-commissioning",
  "revision": 1,
  "title": "Drive commissioning bench",
  "summary": "A conveyor driven by a variable frequency drive (generic VFD behavioral model): run, run enable, fault acknowledge and preset speed terminals from the PLC; ready, running, remote and fault relays back; Start, Stop and Reset buttons, a Slow/Fast speed selector, a run lamp and a fault lamp.",
  "components": [
    {
      "id": "start",
      "label": "Start S1",
      "kind": {
        "type": "pushButton",
        "contact": "normallyOpen",
        "color": "green"
      }
    },
    {
      "id": "stop",
      "label": "Stop S2",
      "kind": {
        "type": "pushButton",
        "contact": "normallyClosed",
        "color": "red"
      }
    },
    {
      "id": "reset",
      "label": "Fault reset S3",
      "kind": {
        "type": "pushButton",
        "contact": "normallyOpen",
        "color": "blue"
      }
    },
    {
      "id": "speed",
      "label": "Speed selector S4",
      "kind": {
        "type": "selectorSwitch",
        "positions": [
          "Slow",
          "Fast"
        ],
        "initial": 0
      }
    },
    {
      "id": "drive",
      "label": "Conveyor drive U1 / motor M1",
      "kind": {
        "type": "variableFrequencyDrive",
        "rampMs": 2000,
        "ratedCurrentMa": 3800,
        "enableTerminal": true,
        "faultTerminals": true,
        "speedPermille": 500,
        "presetPermille": 1000,
        "keypadPermille": 300
      }
    },
    {
      "id": "lamp",
      "label": "Run lamp H1",
      "kind": {
        "type": "pilotLamp",
        "color": "green"
      }
    },
    {
      "id": "fault-lamp",
      "label": "Fault lamp H2",
      "kind": {
        "type": "pilotLamp",
        "color": "red"
      }
    }
  ],
