  "interface": [
    {
      "tag": "StartPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Start button S1, normally open: TRUE while pressed."
    },
    {
      "tag": "StopPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Stop button S2, normally closed: TRUE while NOT pressed."
    },
    {
      "tag": "ResetPB",
      "type": "BOOL",
      "direction": "input",
      "description": "Fault reset button S3, normally open: TRUE while pressed."
    },
    {
      "tag": "FastSelected",
      "type": "BOOL",
      "direction": "input",
      "description": "Speed selector S4: TRUE in position Fast."
    },
    {
      "tag": "DriveReady",
      "type": "BOOL",
      "direction": "input",
      "description": "Drive U1 ready relay: supplied, not faulted, run enable present."
    },
    {
      "tag": "DriveRunning",
      "type": "BOOL",
      "direction": "input",
      "description": "Drive U1 running relay."
    },
    {
      "tag": "DriveRemote",
      "type": "BOOL",
      "direction": "input",
      "description": "Drive U1 in remote (terminal) control."
    },
    {
      "tag": "DriveFault",
      "type": "BOOL",
      "direction": "input",
      "description": "Drive U1 fault relay: TRUE while the drive is faulted."
    },
    {
      "tag": "DriveRun",
      "type": "BOOL",
      "direction": "output",
      "description": "Drive U1 run command terminal."
    },
    {
      "tag": "DriveEnable",
      "type": "BOOL",
      "direction": "output",
      "description": "Drive U1 run enable terminal."
    },
    {
      "tag": "DriveReset",
      "type": "BOOL",
      "direction": "output",
      "description": "Drive U1 fault acknowledge terminal (rising edge)."
    },
    {
      "tag": "DriveFast",
      "type": "BOOL",
      "direction": "output",
      "description": "Drive U1 preset speed terminal: TRUE selects the fast speed."
    },
    {
