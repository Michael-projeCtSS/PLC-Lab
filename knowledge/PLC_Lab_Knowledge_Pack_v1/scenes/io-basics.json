{
  "format": "plclab-scene",
  "schemaVersion": 1,
  "id": "scene.io-basics",
  "revision": 1,
  "title": "Input/output training panel",
  "summary": "A training panel with two pushbuttons, a two-position selector switch, a presence sensor and three pilot lamps wired to a compact PLC. Used to learn inputs, outputs, scan behavior and BOOL logic.",
  "components": [
    { "id": "pb1", "label": "Pushbutton S1", "kind": { "type": "pushButton", "contact": "normallyOpen", "color": "green" } },
    { "id": "pb2", "label": "Pushbutton S2", "kind": { "type": "pushButton", "contact": "normallyOpen", "color": "white" } },
    { "id": "sel", "label": "Selector S3", "kind": { "type": "selectorSwitch", "positions": ["MAN", "AUTO"], "initial": 0 } },
    { "id": "prox", "label": "Proximity sensor B1", "kind": { "type": "presenceSensor", "output": "pnp", "contact": "normallyOpen" } },
    { "id": "h1", "label": "Lamp H1", "kind": { "type": "pilotLamp", "color": "green" } },
    { "id": "h2", "label": "Lamp H2", "kind": { "type": "pilotLamp", "color": "amber" } },
    { "id": "h3", "label": "Lamp H3", "kind": { "type": "pilotLamp", "color": "red" } }
  ],
  "installation": {
    "cpu": "cpu.compact",
    "modules": [
      { "position": { "rack": 0, "slot": 1 }, "module": "di8.24vdc.sink" },
      { "position": { "rack": 0, "slot": 2 }, "module": "do8.24vdc" }
    ],
    "wiring": [
      { "channel": { "rack": 0, "slot": 1, "channel": 0 }, "component": "pb1", "port": "contact" },
      { "channel": { "rack": 0, "slot": 1, "channel": 1 }, "component": "pb2", "port": "contact" },
      { "channel": { "rack": 0, "slot": 1, "channel": 2 }, "component": "sel", "port": "position1" },
      { "channel": { "rack": 0, "slot": 1, "channel": 3 }, "component": "prox", "port": "output" },
      { "channel": { "rack": 0, "slot": 2, "channel": 0 }, "component": "h1", "port": "coil" },
      { "channel": { "rack": 0, "slot": 2, "channel": 1 }, "component": "h2", "port": "coil" },
      { "channel": { "rack": 0, "slot": 2, "channel": 2 }, "component": "h3", "port": "coil" }
    ]
  },
  "referenceStation": {
    "name": "PLC_1",
    "cpu": "cpu.compact",
    "modules": [
      { "position": { "rack": 0, "slot": 1 }, "module": "di8.24vdc.sink", "startAddress": 0 },
      { "position": { "rack": 0, "slot": 2 }, "module": "do8.24vdc", "startAddress": 0 }
    ],
    "ioMap": [
      { "channel": { "rack": 0, "slot": 1, "channel": 0 }, "tag": "Button1" },
      { "channel": { "rack": 0, "slot": 1, "channel": 1 }, "tag": "Button2" },
      { "channel": { "rack": 0, "slot": 1, "channel": 2 }, "tag": "AutoMode" },
      { "channel": { "rack": 0, "slot": 1, "channel": 3 }, "tag": "PartPresent" },
      { "channel": { "rack": 0, "slot": 2, "channel": 0 }, "tag": "Lamp1" },
      { "channel": { "rack": 0, "slot": 2, "channel": 1 }, "tag": "Lamp2" },
      { "channel": { "rack": 0, "slot": 2, "channel": 2 }, "tag": "Lamp3" }
    ]
  },
  "interface": [
    { "tag": "Button1", "type": "BOOL", "direction": "input", "description": "Pushbutton S1, normally open." },
    { "tag": "Button2", "type": "BOOL", "direction": "input", "description": "Pushbutton S2, normally open." },
    { "tag": "AutoMode", "type": "BOOL", "direction": "input", "description": "Selector S3 in position AUTO." },
    { "tag": "PartPresent", "type": "BOOL", "direction": "input", "description": "Proximity sensor B1 detects a part." },
    { "tag": "Lamp1", "type": "BOOL", "direction": "output", "description": "Green lamp H1." },
    { "tag": "Lamp2", "type": "BOOL", "direction": "output", "description": "Amber lamp H2." },
    { "tag": "Lamp3", "type": "BOOL", "direction": "output", "description": "Red lamp H3." }
  ],
  "layout": [
    { "component": "pb1", "x": 120, "y": 380 },
    { "component": "pb2", "x": 240, "y": 380 },
    { "component": "sel", "x": 360, "y": 380 },
    { "component": "prox", "x": 500, "y": 200 },
    { "component": "h1", "x": 620, "y": 380 },
    { "component": "h2", "x": 720, "y": 380 },
    { "component": "h3", "x": 820, "y": 380 }
  ],
  "knowledgeRefs": ["fundamentals.digital-io", "fundamentals.plc-scan"]
}
