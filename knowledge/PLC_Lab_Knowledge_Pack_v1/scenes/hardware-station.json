  "id": "scene.hardware-station",
  "revision": 1,
  "title": "Modular station: tank skid cabinet",
  "summary": "A tank skid before handover, controlled from a modular cabinet: a modular CPU with a 24 V power supply module, a 16-channel digital input module, a 16-channel digital output module, a 4-channel analog input module and a 2-channel analog output module. The skid has an inlet valve with open and closed limit switches, a high level switch, a 2-wire 4-20 mA level transmitter, start and stop buttons and run and fault lamps. Analog output channel 0 retransmits the level (4-20 mA) to a control room display outside this scene.",
  "components": [
    {
      "id": "start",
      "label": "Start S1",
      "kind": {
        "type": "pushButton",
        "contact": "normallyOpen",
        "color": "green"
      }
    },
    {
      "id": "stop",
      "label": "Stop S2",
      "kind": {
        "type": "pushButton",
        "contact": "normallyClosed",
        "color": "red"
      }
    },
    {
      "id": "inlet",
      "label": "Inlet valve XV-301",
      "kind": {
        "type": "onOffValve",
        "travelMs": 1500,
        "flowMlPerS": 8000
      }
    },
    {
      "id": "tank",
      "label": "Tank T-300",
      "kind": {
        "type": "tank",
        "capacityMl": 100000,
        "initialMl": 20000,
        "highHighMl": 97000,
        "lowLowMl": 5000
      }
    },
    {
      "id": "lsh",
      "label": "High level switch LSH-305",
      "kind": {
        "type": "levelSwitch",
        "tank": "tank",
        "switchLevelMl": 95000,
        "contact": "normallyOpen",
        "output": "pnp"
      }
    },
    {
      "id": "lt",
      "label": "Level transmitter LT-303",
      "kind": {
        "type": "levelTransmitter",
        "tank": "tank",
        "rangeMinMl": 0,
        "rangeMaxMl": 100000,
        "signal": "current4To20mA",
        "wiring": "twoWire"
      }
    },
    {
      "id": "run",
      "label": "Run lamp H1",
      "kind": {
        "type": "pilotLamp",
        "color": "green"
      }
    },
    {
      "id": "fault",
      "label": "Fault lamp H2",
      "kind": {
        "type": "pilotLamp",
        "color": "red"
      }
    }
  ],
